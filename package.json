{
  "name": "@flaukowski/ghostos",
  "version": "0.1.0",
  "description": "Resonant Systems Architecture for Emergent Intelligence",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./signal": {
      "import": {
        "types": "./dist/signal/index.d.mts",
        "default": "./dist/signal/index.mjs"
      },
      "require": {
        "types": "./dist/signal/index.d.ts",
        "default": "./dist/signal/index.js"
      }
    },
    "./resonance": {
      "import": {
        "types": "./dist/resonance/index.d.mts",
        "default": "./dist/resonance/index.mjs"
      },
      "require": {
        "types": "./dist/resonance/index.d.ts",
        "default": "./dist/resonance/index.js"
      }
    },
    "./emergence": {
      "import": {
        "types": "./dist/emergence/index.d.mts",
        "default": "./dist/emergence/index.mjs"
      },
      "require": {
        "types": "./dist/emergence/index.d.ts",
        "default": "./dist/emergence/index.js"
      }
    },
    "./safety": {
      "import": {
        "types": "./dist/safety/index.d.mts",
        "default": "./dist/safety/index.mjs"
      },
      "require": {
        "types": "./dist/safety/index.d.ts",
        "default": "./dist/safety/index.js"
      }
    },
    "./chiral": {
      "import": {
        "types": "./dist/chiral/index.d.mts",
        "default": "./dist/chiral/index.mjs"
      },
      "require": {
        "types": "./dist/chiral/index.d.ts",
        "default": "./dist/chiral/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:run": "node --test test/*.test.mjs",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "resonance",
    "emergence",
    "consciousness",
    "signal-processing",
    "systems-architecture",
    "kuramoto",
    "oscillators",
    "space-child"
  ],
  "author": "Space Child Research Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaukowski/ghostOS.git"
  },
  "bugs": {
    "url": "https://github.com/flaukowski/ghostOS/issues"
  },
  "homepage": "https://github.com/flaukowski/ghostOS#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
